# CookieAudit AI - Environment Configuration
# Copy to .env.local (dev) or inject via secret manager (production).

# ---------------------------------------------------------------- compliance engine
# OpenRouter is optional: without it the deterministic policy evaluator runs.
OPENROUTER_API_KEY=
# Model used for the LLM audit path (validated output; falls back deterministically)
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# Public base URL used in links (PDF certificates, Slack notifications)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------- scraper grid
# Self-hosted deep-crawl microservice (docker-compose.yml). Optional: the
# scanner degrades to the secure HTTP probe + HTML parsing when unreachable.
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=

# ---------------------------------------------------------------- rate limiting
# Redis for globally consistent quotas across instances. Leave unset to use
# the per-process in-memory limiter (single-instance deployments only).
REDIS_URL=

# Trust model for client IP detection (see lib/security/client-ip.ts):
#   rightmost-trusted : behind 1+ reverse proxies appending x-forwarded-for
#                       (nginx self-hosted). TRUSTED_PROXY_COUNT = proxies.
#   leftmost          : PaaS platforms that normalize X-Forwarded-For
#                       (Vercel, Fly, Render).
#   none              : no trusted proxy; all traffic shares one bucket
#                       (fail-closed, spoof-proof).
IP_STRATEGY=rightmost-trusted
TRUSTED_PROXY_COUNT=1
# Alternative/companion headers, tried in order (e.g. cf-connecting-ip)
CLIENT_IP_HEADERS=x-forwarded-for

# Quotas (requests per hour). Defaults are sized for real human usage:
# 100 anonymous scans/hour is a generous interactive budget, while the
# anonymous cap still bounds unauthenticated egress and DNS spend.
SCAN_RATE_LIMIT_PER_HOUR=100
PDF_RATE_LIMIT_PER_HOUR=60
DRIFT_RATE_LIMIT_PER_HOUR=10

# Authenticated high-volume tier (optional). Callers presenting one of these
# keys via "X-API-Key: <key>" or "Authorization: Bearer <key>" are counted
# against the API-key quota in their OWN namespace, never against the
# anonymous-per-IP budget. Comma-separated; entries may carry a label shown
# to the holder (never the key itself):
#   SCAN_API_KEYS="demo-client:sk_demo_a1b2,agency:sk_ag_c3d4"
SCAN_API_KEYS=
# API-key scans per key per hour. 0 = UNLIMITED (no counter, no headers).
SCAN_API_RATE_LIMIT_PER_HOUR=2000

# ---------------------------------------------------------------- audit seal (REQUIRED in production)
# HMAC secret for tamper-evident certificates. MUST be 32+ characters.
# Generate: openssl rand -hex 32
AUDIT_SEAL_SECRET=

# ---------------------------------------------------------------- cron / drift monitor
# Shared secret for /api/v1/cron/drift-scan. Required in production;
# generate: openssl rand -hex 24
DRIFT_CRON_SECRET=
# Default Slack webhook for drift notifications (clients may pass their own)
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- persistence
# Supabase. The SERVICE ROLE key is used SERVER-SIDE ONLY for writes that
# bypass RLS legitimately. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In-memory scan cache bounds (records kept hot for dashboard/PDF reads)
MEMORY_CACHE_MAX_SCANS=250
